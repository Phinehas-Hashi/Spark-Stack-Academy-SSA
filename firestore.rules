rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'unknown'); }
    function isStudent() { return userExists() && role() == 'student'; }
    function isInstructor() { return userExists() && role() == 'instructor'; }
    function isAdmin() { return userExists() && role() == 'admin'; }
    function isFounder() {
      return signedIn()
        && exists(/databases/$(database)/documents/founder/$(request.auth.uid))
        && get(/databases/$(database)/documents/founder/$(request.auth.uid)).data.get('role', 'founder') == 'founder'
        && get(/databases/$(database)/documents/founder/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }
    function staff() { return isAdmin() || isFounder(); }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || staff());
      allow list: if staff();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'student') in ['student', 'instructor'];
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('role', resource.data.get('role', 'student')) == resource.data.get('role', 'student');
      allow delete: if staff();
    }

    match /founder/{founderId} {
      allow get: if signedIn() && (request.auth.uid == founderId || isFounder());
      allow list: if isFounder();
      // Founder identities cannot be created or modified from the client.
      // Provision founder accounts through trusted backend/admin tooling.
      allow create, update, delete: if false;
    }

    match /platform_controls/{controlId} { allow read, write: if isFounder(); }
    match /audit_logs/{logId} { allow read, create: if isFounder(); allow update, delete: if false; }

    match /premiumSubscriptions/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isFounder());
      allow list: if isFounder();
      allow create, update, delete: if isFounder();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.adminVisible == true
        && request.resource.data.founderVisible == (
          request.resource.data.priority == 'critical'
          || request.resource.data.type == 'system'
          || request.resource.data.category == 'security'
        );
      allow get: if signedIn() && (
        resource.data.reporterId == request.auth.uid
        || isAdmin()
        || (isFounder() && resource.data.founderVisible == true)
      );
      allow list: if signedIn() && (
        isAdmin()
        || (isFounder() && resource.data.founderVisible == true)
        || resource.data.reporterId == request.auth.uid
      );
      allow update: if signedIn() && (isAdmin() || isFounder());
      allow delete: if isFounder();
    }

    function roleFor(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'unknown');
    }
    function allowedPair(a, b) {
      return (a == 'founder') || (b == 'founder')
        || (a == 'student' && b == 'instructor')
        || (a == 'instructor' && b == 'student')
        || (a == 'instructor' && b == 'admin')
        || (a == 'admin' && b == 'instructor');
    }
    function isChatMember() {
      return signedIn() && resource.data.participants.hasAny([request.auth.uid]);
    }

    match /chats/{chatId} {
      allow get: if isChatMember();
      allow list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && allowedPair(
          roleFor(request.auth.uid),
          roleFor(request.resource.data.participants[0] == request.auth.uid
            ? request.resource.data.participants[1]
            : request.resource.data.participants[0])
        );
      allow update: if isChatMember() && request.resource.data.participants == resource.data.participants;
      allow delete: if isFounder();

      match /messages/{messageId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow update: if signedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow delete: if isFounder();
      }
    }

    match /notifications/{notificationId} {
      allow get: if signedIn() && (resource.data.userId == request.auth.uid || staff());
      allow list: if staff() || (signedIn() && request.query.limit <= 100);
      allow create: if staff();
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || staff());
      allow delete: if staff();
    }
    match /broadcasts/{broadcastId} { allow read, write: if isFounder(); }
    match /announcements/{announcementId} { allow read: if signedIn(); allow create, update, delete: if staff(); }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create, update: if isInstructor() || staff();
      allow delete: if staff() || (isInstructor() && resource.data.instructorId == request.auth.uid);
    }

    match /enrollments/{enrollmentId} {
      allow get, list: if signedIn() && (staff() || resource.data.studentId == request.auth.uid || resource.data.instructorId == request.auth.uid);
      allow create: if signedIn() && (staff() || request.resource.data.studentId == request.auth.uid);
      allow update: if signedIn() && (staff() || resource.data.studentId == request.auth.uid || resource.data.instructorId == request.auth.uid);
      allow delete: if staff();
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isInstructor() || staff();
    }

    match /submissions/{submissionId} {
      allow get, list: if signedIn() && (staff() || resource.data.studentId == request.auth.uid || resource.data.instructorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && (staff() || resource.data.studentId == request.auth.uid || resource.data.instructorId == request.auth.uid);
      allow delete: if staff();
    }

    match /certificates/{certificateId} {
      allow get, list: if signedIn() && (staff() || resource.data.studentId == request.auth.uid);
      allow create, update, delete: if staff();
    }

    match /settings/{settingsId} { allow read, write: if isFounder(); }
    match /platformSettings/{settingsId} { allow read, write: if isFounder(); }

    match /{document=**} { allow read, write: if false; }
  }
}
