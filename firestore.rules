rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // CORE AUTHORIZATION
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(uid())
        );
    }

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(uid())
      ).data;
    }

    function role() {
      return userData().get('role', 'unknown');
    }

    function isStudent() {
      return userExists()
        && role() == 'student'
        && userData().get('active', true) == true
        && userData().get('status', '') == 'active';
    }

    function isInstructor() {
      return userExists()
        && role() == 'instructor'
        && userData().get('status', '') == 'active'
        && userData().get('active', false) == true
        && userData().get('verified', false) == true;
    }

    function isAdmin() {
      return userExists()
        && role() == 'admin'
        && userData().get('active', true) == true;
    }

    function isFounder() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/founder/$(uid())
        )
        && get(
          /databases/$(database)/documents/founder/$(uid())
        ).data.get('role', '') == 'founder'
        && get(
          /databases/$(database)/documents/founder/$(uid())
        ).data.get('status', '') == 'active'
        && get(
          /databases/$(database)/documents/founder/$(uid())
        ).data.get('active', true) == true
        && get(
          /databases/$(database)/documents/founder/$(uid())
        ).data.get('verified', true) == true;
    }

    function staff() {
      return isAdmin() || isFounder();
    }

    function activePortalUser() {
      return isStudent() || isInstructor();
    }


    // ============================================================
    // PLATFORM CONTROL
    // ============================================================

    function platformControlData() {
      return get(
        /databases/$(database)/documents/platform_controls/global
      ).data;
    }

    function maintenanceActive(portal) {
      let c = platformControlData();
      let m = c.get('maintenance', {});

      return m.get('scheduled', false) == true
        && (
          m.get('target', '') == portal
          || m.get('target', '') == 'all'
        )
        && m.keys().hasAll(['startAt', 'endAt'])
        && request.time >= m.get('startAt')
        && request.time < m.get('endAt');
    }

    function portalBlocked(portal) {
      let c = platformControlData();

      return c.get('lockdown', false) == true
        || c.get(portal, {}).get('suspended', false) == true
        || maintenanceActive(portal);
    }

    function studentPortalOpen() {
      return !portalBlocked('student');
    }

    function instructorPortalOpen() {
      return !portalBlocked('instructor');
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // A user may read their own profile.
      // Staff may read user records.
      allow get:
        if signedIn()
        && (
          uid() == userId
          || staff()
        );

      // Staff can list users.
      // Students/instructors can only use tightly constrained
      // directory queries where their role is permitted.
      allow list:
        if staff();

      // ----------------------------------------------------------
      // ACCOUNT CREATION
      //
      // IMPORTANT:
      // Client-created accounts may ONLY be students.
      // No browser client can create an instructor/admin/founder.
      // ----------------------------------------------------------

      allow create:
        if signedIn()
        && uid() == userId
        && (
          (
            request.resource.data.get('role', 'student') == 'student'
            && request.resource.data.get('status', 'pending_admission') == 'pending_admission'
            && request.resource.data.get('active', true) == true
            && request.resource.data.get('verified', false) == false
          )
          ||
          (
            request.resource.data.get('role', '') == 'instructor'
            && request.resource.data.get('status', 'pending_review') == 'pending_review'
            && request.resource.data.get('active', true) == true
            && request.resource.data.get('verified', false) == false
          )
        )
        && request.resource.data.get('uid', uid()) == uid();

      // ----------------------------------------------------------
      // SELF PROFILE UPDATE
      // ----------------------------------------------------------

      allow update:
        if signedIn()
        && uid() == userId
        && request.resource.data.get('role', resource.data.get('role', 'unknown'))
             == resource.data.get('role', 'unknown')
        && request.resource.data.get('active', resource.data.get('active', true))
             == resource.data.get('active', true)
        && request.resource.data.get('verified', resource.data.get('verified', false))
             == resource.data.get('verified', false)
        && request.resource.data.get('status', resource.data.get('status', ''))
             == resource.data.get('status', '')
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               'fullName',
               'name',
               'displayName',
               'bio',
               'expertise',
               'profilePhoto',
               'photoURL',
               'phone',
               'lastLogin',
               'updatedAt'
             ])

      // Founder may approve/reject instructors only.
      || (
        isFounder()
        && resource.data.get('role', '') == 'instructor'
        && request.resource.data.get('role', '') == 'instructor'
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               'status',
               'active',
               'verified',
               'approvedBy',
               'approvedByEmail',
               'approvedAt',
               'rejectedBy',
               'rejectedByEmail',
               'rejectedAt',
               'rejectionReason',
               'updatedAt'
             ])
      );

      allow delete:
        if isFounder();
    }


    // ============================================================
    // FOUNDER
    // ============================================================

    match /founder/{founderId} {

      // Founder may read own Founder document.
      allow get:
        if signedIn()
        && (
          uid() == founderId
          || isFounder()
        );

      allow list:
        if isFounder();

      // Founder identity MUST NOT be client-created or deleted.
      // This is provisioned by trusted server/admin tooling.
      allow create, update, delete:
        if false;
    }


    // ============================================================
    // STUDENT PROFILES
    // ============================================================

    match /students/{studentId} {

      allow get:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && uid() == studentId
        );

      allow list:
        if staff();

      // Initial student profile creation.
      allow create:
        if signedIn()
        && uid() == studentId
        && request.resource.data.uid == uid()
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'Pending'
        && request.resource.data.onboardingStatus == 'awaiting_admission'
        && request.resource.data.admissionNumber == 'Pending'
        && request.resource.data.level == 1
        && request.resource.data.xp == 0
        && request.resource.data.streak == 0;

      allow update:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && uid() == studentId
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'name',
                 'phone',
                 'updatedAt',
                 'xp',
                 'lastXPReward',
                 'lastXPReason',
                 'level',
                 'lastLevelUp',
                 'lastLevelUpAt',
                 'streak',
                 'lastActiveDate',
                 'lastActiveAt',
                 'badges',
                 'stats'
               ])
        );

      allow delete:
        if isFounder();
    }


    // ============================================================
    // STUDENT ACTIVITY
    // ============================================================

    match /students/{studentId}/activity/{activityId} {
      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && uid() == studentId
        );

      allow create:
        if isStudent()
        && studentPortalOpen()
        && uid() == studentId;

      allow update, delete:
        if isFounder();
    }


    // ============================================================
    // LEGACY / NESTED ENROLLMENTS
    // ============================================================

    match /students/{studentId}/enrollments/{enrollmentId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && uid() == studentId
        );

      // Enrollment creation/modification is trusted-operation only.
      allow create, update, delete:
        if staff();
    }


    // ============================================================
    // STUDENT SETTINGS
    // ============================================================

    match /studentSettings/{userId} {

      allow get, write:
        if isStudent()
        && studentPortalOpen()
        && uid() == userId;

      allow list:
        if staff();
    }


    // ============================================================
    // ACCOUNT DELETION
    // ============================================================

    match /accountDeletionRequests/{userId} {

      allow get:
        if signedIn()
        && (
          uid() == userId
          || staff()
        );

      allow create:
        if signedIn()
        && uid() == userId
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending';

      allow update, delete:
        if staff();

      allow list:
        if staff();
    }


    // ============================================================
    // INSTRUCTORS
    // ============================================================

    match /instructors/{instructorId} {

      allow get:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && uid() == instructorId
        );

      allow list:
        if staff();

      // Instructor profiles are controlled by staff.
      allow create, update, delete:
        if staff();
    }


    // ============================================================
    // ADMISSIONS / APPLICATIONS
    // ============================================================

    match /applications/{applicationId} {

      // A user may submit their own application.
      allow create:
        if signedIn()
        && request.resource.data.studentUid == uid();

      // Applicant can view their own application.
      allow get:
        if signedIn()
        && resource.data.studentUid == uid()
        || staff();

      allow list:
        if staff();

      allow update, delete:
        if staff();
    }


    // ============================================================
    // PAYMENTS
    // ============================================================

    match /payments/{paymentId} {

      // Users can view their own payment history.
      // Staff can view all payments.
      allow get, list:
        if staff()
        || (
          signedIn()
          && resource.data.userId == uid()
        );

      // NO CLIENT PAYMENT CREATION.
      //
      // Payment records are created by trusted backend/Admin SDK
      // after payment initialization/verification.
      allow create, update, delete:
        if staff();
    }


    // ============================================================
    // WITHDRAWALS
    // ============================================================

    match /withdrawals/{withdrawalId} {

      allow get, list:
        if isFounder();

      allow create, update:
        if isFounder();

      allow delete:
        if false;
    }


    match /withdrawalRequests/{requestId} {

      allow get, list:
        if isFounder()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );

      allow create:
        if isInstructor()
        && instructorPortalOpen()
        && request.resource.data.instructorId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.method is string
        && request.resource.data.account is string;

      allow update, delete:
        if isFounder();
    }


    // ============================================================
    // INSTRUCTOR EARNINGS
    // ============================================================

    match /instructorEarnings/{earningId} {

      allow get, list:
        if isFounder()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );

      // Earnings are trusted financial records.
      allow create, update, delete:
        if isFounder();
    }


    match /instructorWallets/{walletId} {

      allow get, list:
        if isFounder();

      allow create, update, delete:
        if isFounder();
    }


    match /walletActions/{actionId} {

      allow get, list:
        if isFounder();

      allow create:
        if isFounder();

      allow update, delete:
        if false;
    }


    match /finance/{financeId} {

      allow get, list:
        if isFounder();

      allow create, update:
        if isFounder();

      allow delete:
        if false;
    }


    match /financeTransactions/{transactionId} {

      allow get, list:
        if isFounder();

      allow create:
        if isFounder();

      allow update, delete:
        if false;
    }


    // ============================================================
    // AUDIT LOGS
    // ============================================================

    match /audit_logs/{logId} {

      allow read, create:
        if isFounder();

      allow update, delete:
        if false;
    }


    // ============================================================
    // PLATFORM CONTROLS
    // ============================================================

    match /platform_controls/{controlId} {

      // Users need to read global portal state so the UI can
      // display maintenance/suspension.
      allow get:
        if signedIn();

      allow list:
        if false;

      // Only Founder can control platform state.
      allow create, update, delete:
        if isFounder();
    }


    // ============================================================
    // ACTIVITY
    // ============================================================

    match /activity/{activityId} {

      allow read:
        if staff();

      allow create:
        if staff();

      allow update, delete:
        if isFounder();
    }


    // ============================================================
    // PREMIUM SUBSCRIPTIONS
    // ============================================================

    match /premiumSubscriptions/{userId} {

      allow get:
        if signedIn()
        && (
          uid() == userId
          || isFounder()
        );

      allow list:
        if isFounder();

      // Subscription state is trusted data.
      allow create, update, delete:
        if isFounder();
    }


    // ============================================================
    // REPORTS
    // ============================================================

    match /reports/{reportId} {

      allow create:
        if signedIn()
        && request.resource.data.reporterId == uid();

      allow get:
        if signedIn()
        && (
          resource.data.reporterId == uid()
          || isAdmin()
          || isFounder()
        );

      allow list:
        if staff();

      allow update:
        if staff();

      allow delete:
        if isFounder();
    }


    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {

      allow get:
        if signedIn()
        && (
          resource.data.userId == uid()
          || staff()
        );

      allow list:
        if staff()
        || (
          signedIn()
          && resource.data.userId == uid()
        );

      allow create:
        if staff();

      // User can only mark own notification read.
      allow update:
        if staff()
        || (
          signedIn()
          && resource.data.userId == uid()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'read',
                 'readAt',
                 'updatedAt'
               ])
        );

      allow delete:
        if staff();
    }


    // ============================================================
    // BROADCASTS
    // ============================================================

    match /broadcasts/{broadcastId} {

      allow read:
        if staff()
        || activePortalUser();

      allow create, update, delete:
        if isFounder();
    }


    // ============================================================
    // ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {

      allow read:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
        );

      allow create, update, delete:
        if staff();
    }


    // ============================================================
    // COURSES
    // ============================================================

    match /courses/{courseId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
        );

      allow create:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
        );

      allow update:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
        );

      allow delete:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );
    }


    // ============================================================
    // CANONICAL ENROLLMENTS
    // ============================================================

    match /enrollments/{enrollmentId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && (
            resource.data.studentId == uid()
            || resource.data.userId == uid()
          )
        )
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );

      // Enrollment creation is trusted.
      // Backend/Admin SDK should create paid enrollments.
      allow create:
        if staff();

      // Students may update ONLY harmless learning-progress fields.
      // They cannot alter payment, owner, course, status or identity.
      allow update:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && (
            resource.data.studentId == uid()
            || resource.data.userId == uid()
          )
          && request.resource.data.studentId
               == resource.data.studentId
          && request.resource.data.userId
               == resource.data.userId
          && request.resource.data.courseId
               == resource.data.courseId
          && request.resource.data.paymentStatus
               == resource.data.paymentStatus
          && request.resource.data.status
               == resource.data.status
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'progress',
                 'completedLessons',
                 'lastLessonId',
                 'lastAccessedAt',
                 'updatedAt'
               ])
        )
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'progress',
                 'grade',
                 'feedback',
                 'updatedAt'
               ])
        );

      allow delete:
        if isFounder();
    }


    // ============================================================
    // ASSIGNMENTS
    // ============================================================

    match /assignments/{assignmentId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
        );

      allow create:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
        );

      allow update:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
        );

      allow delete:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );
    }


    // ============================================================
    // COURSE MODULES
    // ============================================================

    match /courseModules/{moduleId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
        );

      allow create:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
        );

      allow update, delete:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
        );
    }


    // ============================================================
    // COURSE LESSONS
    // ============================================================

    match /courseLessons/{lessonId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
        );

      allow create:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
        );

      allow update, delete:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
        );
    }


    // ============================================================
    // QUIZZES
    // ============================================================

    match /quizzes/{quizId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
        );

      allow create:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
        );

      allow update, delete:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
        );
    }


    // ============================================================
    // SUBMISSIONS
    // ============================================================

    match /submissions/{submissionId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && resource.data.studentId == uid()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );

      allow create:
        if isStudent()
        && studentPortalOpen()
        && request.resource.data.studentId == uid();

      allow update:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && resource.data.studentId == uid()
          && request.resource.data.studentId == uid()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );

      allow delete:
        if staff();
    }


    // ============================================================
    // QUIZ SUBMISSIONS
    // ============================================================

    match /quizSubmissions/{submissionId} {
      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && resource.data.studentId == uid()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );

      allow create:
        if isStudent()
        && studentPortalOpen()
        && request.resource.data.studentId == uid();

      allow update:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && resource.data.studentId == uid()
          && request.resource.data.studentId == uid()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
        );

      allow delete:
        if staff();
    }


    // ============================================================
    // CERTIFICATES
    // ============================================================

    match /certificates/{certificateId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && resource.data.studentId == uid()
        );

      allow create, update, delete:
        if staff();
    }


    // ============================================================
    // FOUNDER SETTINGS
    // ============================================================

    match /settings/{settingsId} {

      allow read, write:
        if isFounder();
    }

    match /platformSettings/{settingsId} {

      allow read:
        if isFounder();

      allow write:
        if isFounder();
    }


    // ============================================================
    // CHAT ROOMS
    // ============================================================

    function chatMember(chatId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/chats/$(chatId)
        )
        && (
          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.get('memberIds', []).hasAny([uid()])
          ||
          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.get('participants', []).hasAny([uid()])
        );
    }

    function validChatMembers() {
      return (
        (
          request.resource.data.get('memberIds', []).size() == 2
          && request.resource.data.memberIds.hasAny([uid()])
        )
        ||
        (
          request.resource.data.get('participants', []).size() == 2
          && request.resource.data.participants.hasAny([uid()])
        )
      );
    }


    match /chats/{chatId} {

      allow get:
        if staff()
        || (
          activePortalUser()
          && (
            resource.data.get('memberIds', []).hasAny([uid()])
            ||
            resource.data.get('participants', []).hasAny([uid()])
          )
        );

      allow list:
        if staff()
        || activePortalUser();

      allow create:
        if activePortalUser()
        && validChatMembers();

      allow update:
        if staff()
        || (
          activePortalUser()
          && chatMember(chatId)
          && request.resource.data.get('memberIds', [])
               == resource.data.get('memberIds', [])
          && request.resource.data.get('participants', [])
               == resource.data.get('participants', [])
        );

      allow delete:
        if isFounder();


      // ==========================================================
      // CHAT MESSAGES
      // ==========================================================

      match /messages/{messageId} {

        allow get, list:
          if staff()
          || (
            activePortalUser()
            && chatMember(chatId)
          );

        allow create:
          if activePortalUser()
          && chatMember(chatId)
          && request.resource.data.senderId == uid();

        allow update:
          if activePortalUser()
          && chatMember(chatId)
          && resource.data.senderId == uid();

        allow delete:
          if isFounder();
      }
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write:
        if false;
    }
  }
}