rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // CORE AUTHORIZATION
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(uid())
        );
    }

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(uid())
      ).data;
    }

    function role() {
      return userData().get('role', 'unknown');
    }

    function isStudent() {
      return userExists()
        && role() == 'student'
        && userData().get('active', true) == true
        && userData().get('status', '') == 'active';
    }

    function isInstructor() {
      return userExists()
        && role() == 'instructor'
        && userData().get('status', '') == 'active'
        && userData().get('active', false) == true
        && userData().get('verified', false) == true;
    }

    function isAdmin() {
      return userExists()
        && role() == 'admin'
        && userData().get('active', false) == true
        && userData().get('status', '') == 'active';
    }

    function isFounder() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/founder/$(uid())
        )
        && get(
          /databases/$(database)/documents/founder/$(uid())
        ).data.get('role', '') == 'founder'
        && get(
          /databases/$(database)/documents/founder/$(uid())
        ).data.get('status', '') == 'active'
        && get(
          /databases/$(database)/documents/founder/$(uid())
        ).data.get('active', false) == true
        && get(
          /databases/$(database)/documents/founder/$(uid())
        ).data.get('verified', false) == true
        ;
    }

    function staff() {
      return isAdmin() || isFounder();
    }

    function activePortalUser() {
      return isStudent() || isInstructor();
    }

    // Canonical tenant authorization: membership documents are provisioned
    // only by trusted server workflows and are scoped to a single institution.
    function canonicalInstitutionMember(institutionId) {
      let memberPath = /databases/$(database)/documents/institutions/$(institutionId)/members/$(uid());
      return signedIn()
        && exists(memberPath)
        && get(memberPath).data.get('uid', uid()) == uid()
        && get(memberPath).data.get('institutionId', institutionId) == institutionId
        && get(memberPath).data.get('status', '') == 'active'
        && get(memberPath).data.get('verified', false) == true;
    }

    // Temporary compatibility for legacy single-institution accounts.
    function legacyInstitutionMember(institutionId) {
      return signedIn()
        && userExists()
        && userData().get('institutionId', '') == institutionId
        && userData().get('status', '') == 'active'
        && userData().get('active', false) == true
        && userData().get('verified', false) == true
        && userData().get('role', '') in ['institution', 'institution_owner', 'institution_admin', 'instructor'];
    }

    function institutionMember(institutionId) {
      return canonicalInstitutionMember(institutionId)
        || legacyInstitutionMember(institutionId);
    }

    function institutionOwner(institutionId) {
      let memberPath = /databases/$(database)/documents/institutions/$(institutionId)/members/$(uid());
      return (canonicalInstitutionMember(institutionId)
          && get(memberPath).data.get('role', '') in ['institution_owner', 'owner'])
        || (legacyInstitutionMember(institutionId)
          && userData().get('institutionRole', '') == 'owner');
    }

    function institutionManager(institutionId) {
      let memberPath = /databases/$(database)/documents/institutions/$(institutionId)/members/$(uid());
      return (canonicalInstitutionMember(institutionId)
          && get(memberPath).data.get('role', '') in ['institution_owner', 'owner', 'institution_admin', 'department_manager'])
        || (legacyInstitutionMember(institutionId)
          && userData().get('institutionRole', '') in ['owner', 'institution_admin']);
    }

    function institutionApplicant(institutionId) {
      let memberPath = /databases/$(database)/documents/institutions/$(institutionId)/members/$(uid());
      return signedIn()
        && exists(memberPath)
        && get(memberPath).data.get('uid', uid()) == uid()
        && get(memberPath).data.get('institutionId', institutionId) == institutionId
        && get(memberPath).data.get('status', '') == 'pending_verification'
        && get(memberPath).data.get('verified', true) == false;
    }

    function publicCourse(courseId) {
      return courseId is string
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.get('published', false) == true
        && get(/databases/$(database)/documents/courses/$(courseId)).data.get('status', '') == 'published'
        && get(/databases/$(database)/documents/courses/$(courseId)).data.get('reviewStatus', '') == 'approved'
        && get(/databases/$(database)/documents/courses/$(courseId)).data.get('marketplaceVisibility', 'public') != 'hidden'
        && get(/databases/$(database)/documents/courses/$(courseId)).data.get('deletedAt', null) == null;
    }

    function activeCourseEnrollment(courseId) {
      let canonicalPath = /databases/$(database)/documents/enrollments/$(uid() + '_' + courseId);
      let legacyPath = /databases/$(database)/documents/students/$(uid())/enrollments/$(courseId);
      return courseId is string
        && (
          (exists(canonicalPath)
            && get(canonicalPath).data.get('courseId', '') == courseId
            && (get(canonicalPath).data.get('userId', '') == uid() || get(canonicalPath).data.get('studentId', '') == uid())
            && get(canonicalPath).data.get('status', '') in ['active', 'approved', 'completed', 'paid']
            && (get(canonicalPath).data.get('paymentStatus', '') in ['paid', 'free']
              || get(canonicalPath).data.get('institutionId', '') != ''
              || get(canonicalPath).data.get('status', '') == 'paid'))
          || (exists(legacyPath)
            && get(legacyPath).data.get('courseId', courseId) == courseId
            && get(legacyPath).data.get('status', '') in ['active', 'approved', 'completed', 'paid']
            && (get(legacyPath).data.get('paymentStatus', '') in ['paid', 'free']
              || get(legacyPath).data.get('institutionId', '') != ''
              || get(legacyPath).data.get('status', '') == 'paid'))
        );
    }

    function instructorOwnsCourse(courseId) {
      return isInstructor() && instructorPortalOpen()
        && courseId is string
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == uid();
    }

    function studentCanReadLesson() {
      let courseId = resource.data.get('courseId', resource.data.get('courseID', ''));
      return isStudent() && studentPortalOpen() && courseId is string
        && (activeCourseEnrollment(courseId)
          || (resource.data.get('isPreview', false) == true && publicCourse(courseId)));
    }

    function studentCanReadModule() {
      let courseId = resource.data.get('courseId', resource.data.get('courseID', ''));
      return isStudent() && studentPortalOpen() && courseId is string
        && (publicCourse(courseId) || activeCourseEnrollment(courseId));
    }


    // ============================================================
    // PLATFORM CONTROL
    // ============================================================

    function platformControlData() {
      return get(
        /databases/$(database)/documents/platform_controls/global
      ).data;
    }

    function maintenanceActive(portal) {
      let c = platformControlData();
      let m = c.get('maintenance', {});

      return m.get('scheduled', false) == true
        && (
          m.get('target', '') == portal
          || m.get('target', '') == 'all'
        )
        && m.keys().hasAll(['startAt', 'endAt'])
        && request.time >= m.get('startAt')
        && request.time < m.get('endAt');
    }

    function portalBlocked(portal) {
      let c = platformControlData();

      return c.get('lockdown', false) == true
        || c.get(portal, {}).get('suspended', false) == true
        || maintenanceActive(portal);
    }

    function studentPortalOpen() {
      return !portalBlocked('student');
    }

    function instructorPortalOpen() {
      return !portalBlocked('instructor');
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // A user may read their own profile.
      // Staff may read user records.
      allow get:
        if signedIn()
        && (
          uid() == userId
          || staff()
        );

      // Directory listing is limited to roles the signed-in
      // portal user is permitted to contact. This keeps the
      // messaging directory useful without exposing arbitrary
      // user records to the browser.
      allow list:
        if isFounder()
        || (
          activePortalUser()
          && (
            (isStudent() && resource.data.get('role', '') == 'instructor')
            || (isInstructor() && resource.data.get('role', '') in ['student', 'admin'])
            || (isAdmin() && resource.data.get('role', '') in ['instructor', 'founder'])
          )
        );

      // ----------------------------------------------------------
      // ACCOUNT CREATION
      //
      // IMPORTANT:
      // Client-created accounts may ONLY be students.
      // No browser client can create an instructor/admin/founder.
      // ----------------------------------------------------------

      allow create:
        if signedIn()
        && uid() == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'role', 'bio', 'expertise',
          'profilePhoto', 'active', 'verified', 'status', 'provider',
          'createdAt', 'lastLogin'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'email', 'role', 'active',
          'verified', 'status', 'createdAt'
        ])
        && request.resource.data.uid == uid()
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.email is string
        && request.resource.data.active == true
        && request.resource.data.verified == false
        && request.resource.data.createdAt is timestamp
        && (
          (request.resource.data.role == 'student'
            && request.resource.data.status == 'pending_admission')
          ||
          (request.resource.data.role == 'instructor'
            && request.resource.data.status == 'pending_review')
        );

      // ----------------------------------------------------------
      // SELF PROFILE UPDATE
      // ----------------------------------------------------------

      allow update:
        if signedIn()
        && uid() == userId
        && request.resource.data.get('role', resource.data.get('role', 'unknown'))
             == resource.data.get('role', 'unknown')
        && request.resource.data.get('active', resource.data.get('active', true))
             == resource.data.get('active', true)
        && request.resource.data.get('verified', resource.data.get('verified', false))
             == resource.data.get('verified', false)
        && request.resource.data.get('status', resource.data.get('status', ''))
             == resource.data.get('status', '')
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               'fullName',
               'name',
               'displayName',
               'bio',
               'expertise',
               'profilePhoto',
               'photoURL',
               'phone',
               'phoneNumber',
               'location',
               'headline',
               'notifications',
               'teaching',
               'instructorStatus',
               'instructorDisabledAt',
               'lastLogin',
               'online',
               'lastSeen',
               'updatedAt'
             ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['online'])
          || request.resource.data.online is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeen'])
          || request.resource.data.lastSeen is timestamp)

      // Staff may activate a student account only as part of admission approval.
      || (
        staff()
        && resource.data.get('role', '') == 'student'
        && request.resource.data.get('role', '') == 'student'
        && request.resource.data.get('status', '') == 'active'
        && request.resource.data.get('active', false) == true
        && request.resource.data.get('verified', false) == true
        && request.resource.data.get('admissionNumber', '') is string
        && request.resource.data.get('admissionNo', '') is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'active', 'verified',
          'admissionNumber', 'admissionNo',
          'approvedBy', 'approvedAt', 'updatedAt'
        ])
      )

      // Founder may suspend or restore an existing student account.
      || (
        isFounder()
        && resource.data.get('role', '') == 'student'
        && request.resource.data.get('role', '') == 'student'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'active', 'suspensionReason', 'suspendedAt', 'suspendedBy', 'updatedAt'
        ])
        && (
          (
            request.resource.data.get('status', '') == 'suspended'
            && request.resource.data.get('active', true) == false
            && request.resource.data.get('suspensionReason', '') is string
            && request.resource.data.suspensionReason.size() > 0
            && request.resource.data.get('suspendedBy', '') == uid()
            && request.resource.data.get('suspendedAt', request.time) is timestamp
          )
          ||
          (
            resource.data.get('status', '') == 'suspended'
            && request.resource.data.get('status', '') == 'active'
            && request.resource.data.get('active', false) == true
            && request.resource.data.get('suspensionReason', '') == ''
            && request.resource.data.get('suspendedBy', null) == null
            && request.resource.data.get('suspendedAt', null) == null
          )
        )
      )

      // Founder may edit an instructor's public profile fields, but not login identity.
      || (
        isFounder()
        && resource.data.get('role', '') == 'instructor'
        && request.resource.data.get('role', '') == 'instructor'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'expertise', 'bio', 'updatedAt'
        ])
        && request.resource.data.get('fullName', '') is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.get('expertise', '') is string
        && request.resource.data.get('updatedAt', request.time) is timestamp
      )

      // Founder may suspend or restore an approved instructor account.
      || (
        isFounder()
        && resource.data.get('role', '') == 'instructor'
        && request.resource.data.get('role', '') == 'instructor'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'active', 'suspensionReason', 'suspendedAt', 'suspendedBy', 'updatedAt'
        ])
        && (
          (
            request.resource.data.get('status', '') == 'suspended'
            && request.resource.data.get('active', true) == false
            && request.resource.data.get('suspensionReason', '') is string
            && request.resource.data.suspensionReason.size() > 0
            && request.resource.data.get('suspendedBy', '') == uid()
            && request.resource.data.get('suspendedAt', request.time) is timestamp
          )
          ||
          (
            resource.data.get('status', '') == 'suspended'
            && request.resource.data.get('status', '') == 'active'
            && request.resource.data.get('active', false) == true
            && request.resource.data.get('suspensionReason', '') == ''
            && request.resource.data.get('suspendedBy', null) == null
            && request.resource.data.get('suspendedAt', null) == null
          )
        )
      )

      // Founder may approve/reject instructors only.
      || (
        isFounder()
        && resource.data.get('role', '') == 'instructor'
        && request.resource.data.get('role', '') == 'instructor'
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               'status',
               'active',
               'verified',
               'approvedBy',
               'approvedByEmail',
               'approvedAt',
               'rejectedBy',
               'rejectedByEmail',
               'rejectedAt',
               'rejectionReason',
               'updatedAt'
             ])
      );

      allow delete:
        if false;
    }


    // ============================================================
    // FOUNDER
    // ============================================================

    match /founder/{founderId} {

      // Founder may read own Founder document.
      allow get:
        if signedIn()
        && (
          uid() == founderId
          || isFounder()
        );

      allow list:
        if isFounder();

      // Founder identity MUST NOT be client-created or deleted.
      // This is provisioned by trusted server/admin tooling.
      allow create, update, delete:
        if false;
    }


    // ============================================================
    // ADMISSION NUMBER RESERVATIONS
    // A transaction reserves each generated admission number exactly once.
    // ============================================================

    match /admissionNumbers/{admissionNumber} {
      allow get:
        if isFounder();

      allow list:
        if false;

      allow create:
        if isFounder()
        && request.resource.data.get('admissionNumber', '') == admissionNumber
        && request.resource.data.get('studentUid', '') is string
        && request.resource.data.studentUid.size() > 0
        && request.resource.data.get('createdBy', '') == uid()
        && request.resource.data.get('createdAt', request.time) is timestamp
        && request.resource.data.keys().hasAll([
          'admissionNumber', 'studentUid', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'admissionNumber', 'studentUid', 'createdBy', 'createdAt'
        ]);

      allow update, delete:
        if false;
    }


    // ============================================================
    // STUDENT PROFILES
    // ============================================================

    match /students/{studentId} {

      allow get:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && uid() == studentId
        );

      allow list:
        if staff();

      // Initial student profile creation.
      allow create:
        if signedIn()
        && uid() == studentId
        && request.resource.data.uid == uid()
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'Pending'
        && request.resource.data.onboardingStatus == 'awaiting_admission'
        && request.resource.data.admissionNumber == 'Pending'
        && request.resource.data.level == 1
        && request.resource.data.xp == 0
        && request.resource.data.streak == 0;

      allow update:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && uid() == studentId
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'name',
                 'phone',
                 'updatedAt',
                 'xp',
                 'lastXPReward',
                 'lastXPReason',
                 'level',
                 'lastLevelUp',
                 'lastLevelUpAt',
                 'streak',
                 'lastActiveDate',
                 'lastActiveAt',
                 'badges',
                 'stats'
               ])
        );

      allow delete:
        if isFounder();
    }


    // ============================================================
    // STUDENT ACTIVITY
    // ============================================================

    match /students/{studentId}/activity/{activityId} {
      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && uid() == studentId
        );

      allow create:
        if isStudent()
        && studentPortalOpen()
        && uid() == studentId;

      allow update:
        if isFounder();

      // Student records are retained; account closure is a trusted workflow.
      allow delete:
        if false;
    }


    // ============================================================
    // LEGACY / NESTED ENROLLMENTS
    // ============================================================

    match /students/{studentId}/enrollments/{enrollmentId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && uid() == studentId
        );

      // Enrollment creation/modification is trusted-operation only.
      allow create, update, delete:
        if staff();
    }


    // ============================================================
    // STUDENT SETTINGS
    // ============================================================

    match /studentSettings/{userId} {
      allow get: if isStudent() && studentPortalOpen() && uid() == userId;
      allow create: if isStudent() && studentPortalOpen() && uid() == userId
        && request.resource.data.keys().hasOnly(['notifications', 'learning', 'updatedAt'])
        && request.resource.data.notifications is map
        && request.resource.data.learning is map
        && request.resource.data.notifications.keys().hasOnly(['announcements', 'courses', 'assignments', 'payments', 'messages'])
        && request.resource.data.learning.keys().hasOnly(['rememberLesson', 'reminders', 'captions']);
      allow update: if isStudent() && studentPortalOpen() && uid() == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifications', 'learning', 'updatedAt'])
        && request.resource.data.notifications is map
        && request.resource.data.learning is map
        && request.resource.data.notifications.keys().hasOnly(['announcements', 'courses', 'assignments', 'payments', 'messages'])
        && request.resource.data.learning.keys().hasOnly(['rememberLesson', 'reminders', 'captions']);
      allow delete: if false;
      allow list: if staff();
    }


    // ============================================================
    // ACCOUNT DELETION
    // ============================================================

    match /accountDeletionRequests/{userId} {

      allow get:
        if signedIn()
        && (
          uid() == userId
          || staff()
        );

      allow create:
        if signedIn()
        && uid() == userId
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending';

      allow update, delete:
        if staff();

      allow list:
        if staff();
    }


    // ============================================================
    // INSTRUCTORS
    // ============================================================

    match /instructors/{instructorId} {

      allow get:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && uid() == instructorId
        );

      allow list:
        if staff();

      // Instructor profiles are controlled by staff.
      allow create, update, delete:
        if staff();
    }


    // ============================================================
    // ADMISSIONS / APPLICATIONS
    // ============================================================

    match /applications/{applicationId} {

      // A user may submit their own application.
      allow create:
        if signedIn()
        && request.resource.data.studentUid == uid();

      // Applicant can view their own application.
      allow get:
        if signedIn()
        && resource.data.studentUid == uid()
        || staff();

      allow list:
        if staff();

      allow update, delete:
        if staff();
    }


    // ============================================================
    // PAYMENTS
    // ============================================================

    match /payments/{paymentId} {

      // Users can view their own payment history.
      // Staff can view all payments.
      allow get, list:
        if staff()
        || (
          signedIn()
          && resource.data.userId == uid()
        );

      // NO CLIENT PAYMENT CREATION.
      //
      // Payment records are created by trusted backend/Admin SDK
      // after payment initialization/verification.
      allow create, update, delete:
        if staff();
    }


    // ============================================================
    // WITHDRAWALS
    // ============================================================

    match /withdrawals/{withdrawalId} {
      allow get, list: if isFounder();
      // Withdrawal lifecycle changes are performed by audited callable functions.
      allow create, update, delete: if false;
    }

    match /withdrawalRequests/{requestId} {

      allow get, list:
        if isFounder()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );

      // Trusted callable validates and reserves the instructor's balance.
      allow create:
        if false;

      allow update, delete:
        if false;
    }


    // ============================================================
    // INSTRUCTOR EARNINGS
    // ============================================================

    match /instructorEarnings/{earningId} {

      allow get, list:
        if isFounder()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );

      // Earnings are trusted financial records.
      allow create, update, delete:
        if isFounder();
    }


    match /instructorWallets/{walletId} {

      allow get, list:
        if isFounder();

      allow create, update, delete:
        if isFounder();
    }


    match /walletActions/{actionId} {

      allow get, list:
        if isFounder();

      allow create:
        if isFounder();

      allow update:
        if false;
      allow delete:
        if isFounder();
    }


    match /finance/{financeId} {

      allow get, list:
        if isFounder();

      allow create, update:
        if isFounder();

      allow delete:
        if false;
    }


    match /financeTransactions/{transactionId} {

      allow get, list:
        if isFounder();

      allow create:
        if isFounder();

      allow update, delete:
        if false;
    }


    // ============================================================
    // AUDIT LOGS
    // ============================================================

    match /audit_logs/{logId} {

      // Historical audit records are read-only. New security evidence is
      // written by the trusted edge collector, never by browser clients.
      allow read:
        if isFounder();

      allow create, update, delete:
        if false;
    }


    // ============================================================
    // PLATFORM CONTROLS
    // ============================================================

    match /platform_controls/{controlId} {

      // Users need to read global portal state so the UI can
      // display maintenance/suspension.
      allow get:
        if signedIn();

      allow list:
        if false;

      // Only Founder can control platform state.
      allow create, update, delete:
        if isFounder();
    }


    // ============================================================
    // ACTIVITY
    // ============================================================

    match /activity/{activityId} {

      allow read:
        if staff();

      allow create:
        if staff();

      allow update, delete:
        if isFounder();
    }


    // ============================================================
    // PREMIUM SUBSCRIPTIONS
    // ============================================================

    match /premiumSubscriptions/{userId} {

      allow get:
        if signedIn()
        && (
          uid() == userId
          || isFounder()
        );

      allow list:
        if isFounder();

      // Subscription state is trusted data.
      allow create, update, delete:
        if isFounder();
    }

    // ============================================================
    // FOUNDER-CONTROLLED STUDENT MEMBERSHIP PRICING
    // Students can read only the published global price catalogue.
    // Only the verified Founder can create or change pricing.
    // ============================================================
    match /premiumPricing/{pricingId} {
      allow get:
        if pricingId == 'global'
        && (
          isFounder()
          || (isStudent() && studentPortalOpen())
        );

      allow list:
        if false;

      allow create, update:
        if pricingId == 'global' && isFounder();

      allow delete:
        if false;
    }


    // ============================================================
    // REPORTS
    // ============================================================

    match /reports/{reportId} {

      allow create:
        if signedIn()
        && request.resource.data.reporterId == uid()
        && (
          request.resource.data.get('type', '') != 'support'
          || (
            (
              (isStudent() && studentPortalOpen()
                && request.resource.data.get('reporterRole', '') == 'student')
              || (isInstructor() && instructorPortalOpen()
                && request.resource.data.get('reporterRole', '') == 'instructor')
            )
            && request.resource.data.get('status', '') == 'pending'
            && request.resource.data.get('reportId', '') is string
            && request.resource.data.reportId.size() >= 12
            && request.resource.data.get('title', '') is string
            && request.resource.data.title.size() >= 3
            && request.resource.data.title.size() <= 120
            && request.resource.data.get('description', '') is string
            && request.resource.data.description.size() >= 10
            && request.resource.data.description.size() <= 5000
            && request.resource.data.get('category', '') in [
              'technical', 'account', 'payments', 'course',
              'assignments', 'certificates', 'privacy', 'feedback', 'other'
            ]
            && request.resource.data.get('priority', '') in [
              'low', 'medium', 'high', 'critical'
            ]
            && request.resource.data.keys().hasOnly([
              'reportId', 'title', 'description', 'category', 'type',
              'priority', 'status', 'reporterId', 'reporterName',
              'reporterEmail', 'reporterRole', 'reportedUserId',
              'courseId', 'metadata', 'founderVisible', 'adminVisible',
              'createdAt', 'updatedAt'
            ])
          )
        );

      allow get:
        if signedIn()
        && (
          resource.data.reporterId == uid()
          || isAdmin()
          || isFounder()
        );

      // Students can query only their own tickets using reporterId == uid().
      allow list:
        if staff()
        || (
          signedIn()
          && resource.data.reporterId == uid()
        );

      // Students may only confirm a resolved ticket or reopen a closed one.
      // Staff retain the existing full review workflow.
      allow update:
        if staff()
        || (
          signedIn()
          && resource.data.reporterId == uid()
          && request.resource.data.reporterId == resource.data.reporterId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'studentStatusUpdatedAt', 'updatedAt'])
          && request.resource.data.studentStatusUpdatedAt == request.time
          && request.resource.data.updatedAt == request.time
          && (
            (
              resource.data.get('status', '') == 'resolved'
              && request.resource.data.status in ['closed', 'pending']
            )
            || (
              resource.data.get('status', '') in ['dismissed', 'closed']
              && request.resource.data.status == 'pending'
            )
          )
        );

      allow delete:
        if isFounder();

      // Public-facing conversation thread for the ticket owner and staff.
      match /responses/{responseId} {
        allow get, list:
          if staff()
          || (
            signedIn()
            && get(/databases/$(database)/documents/reports/$(reportId))
                 .data.reporterId == uid()
          );

        allow create:
          if staff()
          || (
            signedIn()
            && get(/databases/$(database)/documents/reports/$(reportId))
                 .data.reporterId == uid()
            && getAfter(/databases/$(database)/documents/reports/$(reportId))
                 .data.get('status', '') in ['pending', 'reviewing', 'resolved']
            && request.resource.data.senderId == uid()
            && (
              (isStudent() && studentPortalOpen()
                && request.resource.data.senderRole == 'student')
              || (isInstructor() && instructorPortalOpen()
                && request.resource.data.senderRole == 'instructor')
            )
            && request.resource.data.message is string
            && request.resource.data.message.size() > 0
            && request.resource.data.message.size() <= 5000
            && request.resource.data.keys().hasOnly([
              'message', 'senderId', 'senderName', 'senderRole', 'createdAt'
            ])
          );

        allow update, delete:
          if false;
      }
    }


    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {

      allow get:
        if signedIn()
        && (
          resource.data.userId == uid()
          || staff()
        );

      allow list:
        if staff()
        || (
          signedIn()
          && resource.data.userId == uid()
        );

      allow create:
        if staff();

      // User can only mark own notification read.
      allow update:
        if staff()
        || (
          signedIn()
          && resource.data.userId == uid()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'read',
                 'readAt',
                 'updatedAt'
               ])
        );

      allow delete:
        if staff();
    }


    // ============================================================
    // BROADCASTS
    // ============================================================

    match /broadcasts/{broadcastId} {

      allow read:
        if staff()
        || activePortalUser();

      allow create, update, delete:
        if isFounder();
    }


    // ============================================================
    // CALENDAR EVENTS
    // ============================================================

    match /calendarEvents/{eventId} {
      allow get, list:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && (
            resource.data.get('userId', '') == uid()
            || resource.data.get('audience', '') in ['students', 'instructors', 'all']
          )
        )
        || (
          isStudent()
          && studentPortalOpen()
          && (
            resource.data.get('userId', '') == uid()
            || resource.data.get('audience', '') in ['students', 'all']
          )
        );

      allow create:
        if isInstructor()
        && instructorPortalOpen()
        && request.resource.data.userId == uid()
        && request.resource.data.get('audience', '') in ['students', 'instructors', 'all', 'user', 'private']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 1000
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'type', 'startAt', 'endAt',
          'courseId', 'courseName', 'meetingProvider', 'meetingUrl',
          'userId', 'audience', 'createdAt'
        ]);

      allow update:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.userId == uid()
          && request.resource.data.userId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'type', 'startAt', 'endAt',
            'courseId', 'courseName', 'meetingProvider', 'meetingUrl',
            'audience', 'updatedAt'
          ])
        );

      allow delete:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.userId == uid()
        );
    }


    // ============================================================
    // ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {

      allow read:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
        );

      allow create, update, delete:
        if staff();
    }


    // ============================================================
    // COURSES
    // ============================================================

    match /courses/{courseId} {
      // A marketplace course's public details must remain readable even
      // when a student's account is awaiting admission or a guest is browsing.
      // Only the public course metadata is exposed; write access remains restricted.
      allow get:
        if staff()
        || (isInstructor() && instructorPortalOpen()
          && resource.data.instructorId == uid())
        || (resource.data.get('institutionId', '') != ''
          && institutionMember(resource.data.institutionId))
        || publicCourse(courseId);

      // Instructors can query only their own courses. Student marketplace
      // discovery uses marketplaceItems; public course details use direct get.
      allow list:
        if staff()
        || (isInstructor() && instructorPortalOpen()
          && resource.data.instructorId == uid())
        || (resource.data.get('institutionId', '') != ''
          && institutionMember(resource.data.institutionId));

      allow create:
        if staff()
        || (isInstructor() && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
          && request.resource.data.get('published', false) == false
          && request.resource.data.get('status', 'draft') in ['draft', 'pending_review']
          && request.resource.data.get('reviewStatus', 'draft') != 'approved'
          && request.resource.data.get('marketplaceVisibility', 'hidden') == 'hidden');

      allow update:
        if staff()
        || (isInstructor() && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isFree', 'price', 'discountPrice', 'duration', 'updatedAt',
            'status', 'reviewStatus', 'reviewRouting', 'reviewRequestedAt',
            'marketplaceVisibility'
          ])
          && request.resource.data.get('published', false) == resource.data.get('published', false)
          && (request.resource.data.get('status', resource.data.get('status', 'draft'))
            == resource.data.get('status', 'draft')
            || (request.resource.data.get('status', '') == 'pending_review'
              && request.resource.data.get('reviewStatus', '') == 'awaiting_admin_review'
              && request.resource.data.get('marketplaceVisibility', '') == 'hidden'))
          && (request.resource.data.get('reviewStatus', resource.data.get('reviewStatus', ''))
            == resource.data.get('reviewStatus', '')
            || request.resource.data.get('reviewStatus', '') == 'awaiting_admin_review')
          && (request.resource.data.get('marketplaceVisibility', resource.data.get('marketplaceVisibility', 'hidden'))
            == resource.data.get('marketplaceVisibility', 'hidden')
            || request.resource.data.get('marketplaceVisibility', '') == 'hidden'));

      // Instructors retain deletion access to their own course records.
      // Founder moderation uses a soft-delete Cloud Function to preserve history.
      allow delete: if staff()
        || (isInstructor() && instructorPortalOpen()
          && resource.data.instructorId == uid());
    }



    // COURSE-OWNED CURRICULUM
    match /courses/{courseId}/courseModules/{moduleId} {
      function nestedParentCourse() {
        return get(/databases/$(database)/documents/courses/$(courseId)).data;
      }
      function ownsNestedCourse() {
        return isInstructor() && instructorPortalOpen()
          && nestedParentCourse().get('instructorId', '') == uid();
      }
      allow get, list: if staff() || ownsNestedCourse()
        || (isStudent() && studentPortalOpen()
          && (publicCourse(courseId) || activeCourseEnrollment(courseId)));
      allow create: if staff()
        || (ownsNestedCourse()
          && request.resource.data.get('instructorId', '') == uid()
          && request.resource.data.get('courseId', courseId) == courseId);
      allow update: if staff()
        || (ownsNestedCourse()
          && resource.data.get('instructorId', '') == uid()
          && request.resource.data.get('instructorId', '') == uid()
          && request.resource.data.get('courseId', courseId) == courseId);
      allow delete: if staff()
        || (ownsNestedCourse() && resource.data.get('instructorId', '') == uid());
    }

    match /courses/{courseId}/courseLessons/{lessonId} {
      function nestedParentCourse() {
        return get(/databases/$(database)/documents/courses/$(courseId)).data;
      }
      function ownsNestedCourse() {
        return isInstructor() && instructorPortalOpen()
          && nestedParentCourse().get('instructorId', '') == uid();
      }
      allow get, list: if staff() || ownsNestedCourse()
        || (isStudent() && studentPortalOpen()
          && (activeCourseEnrollment(courseId)
            || (resource.data.get('isPreview', false) == true && publicCourse(courseId))));
      allow create: if staff()
        || (ownsNestedCourse()
          && request.resource.data.get('instructorId', '') == uid()
          && request.resource.data.get('courseId', courseId) == courseId
          && request.resource.data.get('moduleId', '') is string
          && request.resource.data.get('isPreview', false) is bool);
      allow update: if staff()
        || (ownsNestedCourse()
          && resource.data.get('instructorId', '') == uid()
          && request.resource.data.get('instructorId', '') == uid()
          && request.resource.data.get('courseId', courseId) == courseId
          && request.resource.data.get('moduleId', '') is string
          && request.resource.data.get('isPreview', false) is bool);
      allow delete: if staff()
        || (ownsNestedCourse() && resource.data.get('instructorId', '') == uid());
    }

    // ============================================================
    // CANONICAL ENROLLMENTS
    // ============================================================

    match /enrollments/{enrollmentId} {
      allow get: if staff()
        || (isStudent() && studentPortalOpen()
          && ((resource == null && enrollmentId.matches('^' + uid() + '_.+$'))
            || (resource != null && (resource.data.get('studentId', '') == uid()
              || resource.data.get('userId', '') == uid()))))
        || (isInstructor() && instructorPortalOpen()
          && resource != null && resource.data.instructorId == uid());
      allow list: if staff()
        || (isStudent() && studentPortalOpen()
          && (resource.data.get('studentId', '') == uid() || resource.data.get('userId', '') == uid()))
        || (isInstructor() && instructorPortalOpen() && resource.data.instructorId == uid());

      // Paid enrollments are trusted backend records.
      // Free courses may be enrolled by an active student, but
      // the course itself must be free so the browser cannot
      // bypass payment by changing client-side course data.
      allow create:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && request.resource.data.userId == uid()
          && request.resource.data.courseId is string
          && enrollmentId == uid() + '_' + request.resource.data.courseId
          && request.resource.data.status == 'active'
          && request.resource.data.paymentStatus == 'free'
          && request.resource.data.keys().hasOnly(['userId', 'courseId', 'courseTitle', 'paymentStatus', 'status', 'progress', 'completedLessons', 'enrolledAt', 'updatedAt'])
          && request.resource.data.progress == 0
          && request.resource.data.completedLessons is list
          && request.resource.data.completedLessons.size() == 0
          && publicCourse(request.resource.data.courseId)
          && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
          && (get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.get('isFree', false) == true
            || (get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.keys().hasAny(['price'])
              && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price is number
              && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price <= 0))
        );

      // Students may update ONLY harmless learning-progress fields.
      // They cannot alter payment, owner, course, status or identity.
      allow update:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && (
            resource.data.get('studentId', '') == uid()
            || resource.data.get('userId', '') == uid()
          )
          // Preserve ownership and entitlement fields, including legacy records
          // where one optional identity field is absent.
          && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
          && request.resource.data.get('userId', '') == resource.data.get('userId', '')
          && request.resource.data.get('courseId', '') == resource.data.get('courseId', '')
          && request.resource.data.get('paymentStatus', '') == resource.data.get('paymentStatus', '')
          && request.resource.data.get('status', '') == resource.data.get('status', '')
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'progress',
                 'completedLessons',
                 'lastLessonId',
                 'lastAccessedAt',
                 'updatedAt'
               ])
        )
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'progress',
                 'grade',
                 'feedback',
                 'updatedAt'
               ])
        );

      allow delete:
        if isFounder();
    }


    // ============================================================
    // ASSIGNMENTS
    // ============================================================

    match /assignments/{assignmentId} {
      allow get, list: if staff()
        || (isStudent() && studentPortalOpen()
          && resource.data.get('status', 'published') in ['published', 'active']
          && resource.data.get('courseId', '') is string
          && activeCourseEnrollment(resource.data.courseId))
        || (isInstructor() && instructorPortalOpen() && resource.data.instructorId == uid());

      allow create:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
          && request.resource.data.courseId is string
          && instructorOwnsCourse(request.resource.data.courseId)
          && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
          && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.instructorId == uid()
        );

      allow update:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.courseId is string
          && instructorOwnsCourse(resource.data.courseId)
          && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
          && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.instructorId == uid()
        );

      allow delete:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );
    }


    // ============================================================
    // PRIVATE STUDENT COURSE NOTES
    // ============================================================
    match /courseNotes/{noteId} {
      allow get:
        if isStudent()
        && studentPortalOpen()
        && (resource == null || resource.data.userId == uid());

      allow list:
        if false;

      allow create:
        if isStudent()
        && studentPortalOpen()
        && request.resource.data.userId == uid()
        && request.resource.data.courseId is string
        && request.resource.data.lessonId is string
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 10000
        && request.resource.data.keys().hasOnly([
          'userId', 'courseId', 'lessonId', 'notes', 'updatedAt'
        ]);

      allow update:
        if isStudent()
        && studentPortalOpen()
        && resource.data.userId == uid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.lessonId == resource.data.lessonId
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 10000
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['notes', 'updatedAt']);

      allow delete:
        if false;
    }


    // ============================================================
    // COURSE MODULES
    // ============================================================

    match /courseModules/{moduleId} {
      allow get, list: if staff()
        || (isStudent() && studentPortalOpen() && studentCanReadModule())
        || (isInstructor() && instructorPortalOpen() && resource.data.instructorId == uid());
      allow create: if staff()
        || (isInstructor() && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
          && instructorOwnsCourse(request.resource.data.get('courseId', request.resource.data.get('courseID', ''))));
      allow update: if staff()
        || (isInstructor() && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
          && request.resource.data.get('courseId', resource.data.get('courseId', '')) == resource.data.get('courseId', '')
          && request.resource.data.get('courseID', resource.data.get('courseID', '')) == resource.data.get('courseID', '')
          && instructorOwnsCourse(resource.data.get('courseId', resource.data.get('courseID', ''))));
      allow delete: if staff()
        || (isInstructor() && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && instructorOwnsCourse(resource.data.get('courseId', resource.data.get('courseID', ''))));
    }


    // ============================================================
    // COURSE LESSONS
    // ============================================================

    match /courseLessons/{lessonId} {
      allow get, list: if staff()
        || (isStudent() && studentPortalOpen() && studentCanReadLesson())
        || (isInstructor() && instructorPortalOpen() && resource.data.instructorId == uid());
      allow create: if staff()
        || (isInstructor() && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
          && instructorOwnsCourse(request.resource.data.get('courseId', request.resource.data.get('courseID', '')))
          && request.resource.data.get('isPreview', false) is bool);
      allow update: if staff()
        || (isInstructor() && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
          && request.resource.data.get('courseId', resource.data.get('courseId', '')) == resource.data.get('courseId', '')
          && request.resource.data.get('courseID', resource.data.get('courseID', '')) == resource.data.get('courseID', '')
          && request.resource.data.get('isPreview', false) is bool
          && instructorOwnsCourse(resource.data.get('courseId', resource.data.get('courseID', ''))));
      allow delete: if staff()
        || (isInstructor() && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && instructorOwnsCourse(resource.data.get('courseId', resource.data.get('courseID', ''))));
    }


    // ============================================================
    // QUIZZES
    // ============================================================

    match /quizzes/{quizId} {
      allow get, list: if staff()
        || (isStudent() && studentPortalOpen()
          && resource.data.get('courseId', '') is string
          && activeCourseEnrollment(resource.data.courseId)
          && resource.data.get('status', 'draft') in ['published', 'active'])
        || (isInstructor() && instructorPortalOpen() && resource.data.instructorId == uid());
      allow create: if staff()
        || (isInstructor() && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
          && instructorOwnsCourse(request.resource.data.get('courseId', '')));
      allow update: if staff()
        || (isInstructor() && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
          && request.resource.data.courseId == resource.data.courseId
          && instructorOwnsCourse(resource.data.get('courseId', '')));
      allow delete: if staff()
        || (isInstructor() && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && instructorOwnsCourse(resource.data.get('courseId', '')));
    }


    // ============================================================
    // QUIZ QUESTIONS — ANSWER KEYS ARE INSTRUCTOR-ONLY
    // Students must receive sanitized question payloads from a trusted
    // server endpoint; never expose correctAnswer through direct reads.
    // ============================================================

    match /quizQuestions/{questionId} {
      allow get, list:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );

      allow create:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && request.resource.data.instructorId == uid()
          && request.resource.data.quizId is string
          && exists(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId))
          && get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.instructorId == uid()
        );

      allow update:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && request.resource.data.instructorId == uid()
          && request.resource.data.quizId == resource.data.quizId
          && exists(/databases/$(database)/documents/quizzes/$(resource.data.quizId))
          && get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.instructorId == uid()
        );

      allow delete:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && exists(/databases/$(database)/documents/quizzes/$(resource.data.quizId))
          && get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.instructorId == uid()
        );
    }


    // ============================================================
    // SUBMISSIONS
    // ============================================================

    match /submissions/{submissionId} {

      // Instructors access submissions only through an assignment they own.
      // The assignmentId equality in instructor queries lets Firestore prove
      // that every returned submission belongs to this instructor's assignment.
      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && resource.data.studentId == uid()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.assignmentId is string
          && exists(/databases/$(database)/documents/assignments/$(resource.data.assignmentId))
          && get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.instructorId == uid()
        );

      // Students may submit only against an existing published assignment.
      // Grade fields and instructor ownership fields cannot be supplied by clients.
      allow create:
        if isStudent()
        && studentPortalOpen()
        && request.resource.data.studentId == uid()
        && request.resource.data.assignmentId is string
        && exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId))
        && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.get('status', 'published') in ['published', 'pending']
        && request.resource.data.status in ['submitted', 'resubmitted']
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 20000
        && request.resource.data.keys().hasOnly([
          'assignmentId', 'userId', 'studentId', 'studentName',
          'studentEmail', 'content', 'notes', 'status',
          'submittedAt', 'updatedAt'
        ]);

      allow update:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && resource.data.studentId == uid()
          && request.resource.data.studentId == uid()
          && request.resource.data.assignmentId == resource.data.assignmentId
          && !(resource.data.get('status', '') in ['graded', 'reviewed', 'returned'])
          && request.resource.data.status in ['submitted', 'resubmitted']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content', 'notes', 'status', 'submittedAt', 'updatedAt'
          ])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 20000
        )
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.assignmentId is string
          && exists(/databases/$(database)/documents/assignments/$(resource.data.assignmentId))
          && get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.instructorId == uid()
          && request.resource.data.assignmentId == resource.data.assignmentId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'score', 'grade', 'maxScore', 'feedback', 'instructorFeedback',
            'status', 'gradedAt', 'reviewedAt', 'updatedAt'
          ])
          && request.resource.data.status in ['graded', 'reviewed']
          && request.resource.data.score is number
          && request.resource.data.grade is number
          && request.resource.data.maxScore is number
          && request.resource.data.maxScore == get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.get('maxScore', 100)
          && request.resource.data.score >= 0
          && request.resource.data.score <= request.resource.data.maxScore
          && request.resource.data.grade == request.resource.data.score
          && request.resource.data.feedback is string
          && request.resource.data.feedback.size() <= 5000
          && request.resource.data.instructorFeedback == request.resource.data.feedback
        );

      allow delete:
        if staff();
    }


    // ============================================================
    // QUIZ SUBMISSIONS
    // ============================================================

    match /quizSubmissions/{submissionId} {
      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && resource.data.studentId == uid()
        )
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
        );

      // Student attempts are created once. Their score fields are still
      // client-generated in the current player and require server grading
      // before they can be treated as authoritative.
      allow create:
        if isStudent()
        && studentPortalOpen()
        && request.resource.data.studentId == uid()
        && request.resource.data.quizId is string
        && exists(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId))
        && get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.get('status', 'draft') in ['published', 'active']
        && request.resource.data.instructorId == get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.instructorId
        && request.resource.data.keys().hasOnly([
          'studentId', 'quizId', 'courseId', 'instructorId',
          'attemptNumber', 'answers', 'score', 'correct', 'total',
          'passed', 'completed', 'status', 'xpEarned', 'submittedAt'
        ]);

      // Student attempts cannot be edited after creation. Only the owning
      // instructor can update review and grade fields.
      allow update:
        if staff()
        || (
          isInstructor()
          && instructorPortalOpen()
          && resource.data.instructorId == uid()
          && resource.data.quizId is string
          && exists(/databases/$(database)/documents/quizzes/$(resource.data.quizId))
          && get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.instructorId == uid()
          && request.resource.data.instructorId == resource.data.instructorId
          && request.resource.data.quizId == resource.data.quizId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'answers', 'score', 'totalMarks', 'percentage', 'status',
            'result', 'instructorFeedback', 'gradedBy', 'gradedAt',
            'reviewedAt', 'updatedAt'
          ])
          && request.resource.data.status == 'graded'
          && request.resource.data.answers is list
          && request.resource.data.score is number
          && request.resource.data.totalMarks is number
          && request.resource.data.totalMarks > 0
          && request.resource.data.score >= 0
          && request.resource.data.score <= request.resource.data.totalMarks
          && request.resource.data.percentage is number
          && request.resource.data.percentage >= 0
          && request.resource.data.percentage <= 100
          && request.resource.data.result in ['passed', 'failed']
          && request.resource.data.instructorFeedback is string
          && request.resource.data.instructorFeedback.size() <= 5000
          && request.resource.data.gradedBy == uid()
        );

      allow delete:
        if staff();
    }


    // ============================================================
    // CERTIFICATES
    // ============================================================

    match /certificates/{certificateId} {

      allow get, list:
        if staff()
        || (
          isStudent()
          && studentPortalOpen()
          && resource.data.studentId == uid()
        );

      allow create, update, delete:
        if staff();
    }


    // ============================================================
    // FOUNDER SETTINGS
    // ============================================================

    match /settings/{settingsId} {

      allow read:
        if isFounder();

      // Retired client-managed security preferences are no longer writable.
      allow write:
        if isFounder() && settingsId != 'security' && settingsId != 'monetization' && settingsId != 'sparkAI';
    }

    match /platformSettings/{settingsId} {

      allow read:
        if isFounder();

      // Earnings policy is updated only by trusted callable functions.
      allow write:
        if isFounder() && settingsId != 'earnings';
    }


    // ============================================================
    // CHAT ROOMS
    // ============================================================

    function chatMember(chatId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/chats/$(chatId)
        )
        && (
          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.get('memberIds', []).hasAny([uid()])
          ||
          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.get('participants', []).hasAny([uid()])
        );
    }

    function validChatMembers() {
      let ids = request.resource.data.get('memberIds', []);
      let participants = request.resource.data.get('participants', []);
      let members = ids.size() == 2 ? ids : participants;

      return members.size() == 2
        && members[0] != members[1]
        && members.hasAny([uid()])
        && exists(/databases/$(database)/documents/users/$(members[0]))
        && exists(/databases/$(database)/documents/users/$(members[1]))
        && (
          // Student <-> instructor
          (
            role() == 'student'
            && get(/databases/$(database)/documents/users/$(members[0])).data.get('role', '') == 'student'
            && get(/databases/$(database)/documents/users/$(members[1])).data.get('role', '') == 'instructor'
          )
          || (
            role() == 'student'
            && get(/databases/$(database)/documents/users/$(members[1])).data.get('role', '') == 'student'
            && get(/databases/$(database)/documents/users/$(members[0])).data.get('role', '') == 'instructor'
          )
          // Instructor <-> student/admin
          || (
            role() == 'instructor'
            && get(/databases/$(database)/documents/users/$(members[0])).data.get('role', '') == 'instructor'
            && get(/databases/$(database)/documents/users/$(members[1])).data.get('role', '') in ['student', 'admin']
          )
          || (
            role() == 'instructor'
            && get(/databases/$(database)/documents/users/$(members[1])).data.get('role', '') == 'instructor'
            && get(/databases/$(database)/documents/users/$(members[0])).data.get('role', '') in ['student', 'admin']
          )
          // Admin <-> instructor/founder
          || (
            role() == 'admin'
            && get(/databases/$(database)/documents/users/$(members[0])).data.get('role', '') == 'admin'
            && get(/databases/$(database)/documents/users/$(members[1])).data.get('role', '') in ['instructor', 'founder']
          )
          || (
            role() == 'admin'
            && get(/databases/$(database)/documents/users/$(members[1])).data.get('role', '') == 'admin'
            && get(/databases/$(database)/documents/users/$(members[0])).data.get('role', '') in ['instructor', 'founder']
          )
          // Founder <-> permitted portal/admin roles
          || (
            role() == 'founder'
            && get(/databases/$(database)/documents/users/$(members[0])).data.get('role', '') == 'founder'
            && get(/databases/$(database)/documents/users/$(members[1])).data.get('role', '') in ['student', 'instructor', 'admin']
          )
          || (
            role() == 'founder'
            && get(/databases/$(database)/documents/users/$(members[1])).data.get('role', '') == 'founder'
            && get(/databases/$(database)/documents/users/$(members[0])).data.get('role', '') in ['student', 'instructor', 'admin']
          )
        );
    }


    match /chats/{chatId} {

      allow get:
        if staff()
        || (
          activePortalUser()
          && (
            resource.data.get('memberIds', []).hasAny([uid()])
            ||
            resource.data.get('participants', []).hasAny([uid()])
          )
        );

      allow list:
        if staff()
        || (
          activePortalUser()
          && (
            resource.data.get('memberIds', []).hasAny([uid()])
            ||
            resource.data.get('participants', []).hasAny([uid()])
          )
        );

      allow create:
        if (
          staff()
          || activePortalUser()
        )
        && validChatMembers();

      allow update:
        if staff()
        || (activePortalUser() && chatMember(chatId)
          && request.resource.data.get('memberIds', []) == resource.data.get('memberIds', [])
          && request.resource.data.get('participants', []) == resource.data.get('participants', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastSenderId', 'lastMessageAt', 'updatedAt', 'lastReadAt', 'typing'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSenderId'])
            || request.resource.data.lastSenderId == uid())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
            || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['typing'])
            || (request.resource.data.typing.get('uid', '') == uid()
              && request.resource.data.typing.get('status', false) is bool
              && request.resource.data.typing.get('updatedAt', request.time) is timestamp))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastReadAt'])
            || (request.resource.data.lastReadAt is map
              && request.resource.data.lastReadAt.diff(resource.data.get('lastReadAt', {})).affectedKeys().hasOnly([uid()])
              && request.resource.data.lastReadAt.get(uid(), null) is timestamp)));

      allow delete:
        if isFounder();


      // ==========================================================
      // CHAT MESSAGES
      // ==========================================================

      match /messages/{messageId} {

        allow get, list:
          if staff()
          || (
            activePortalUser()
            && chatMember(chatId)
          );

        allow create: if activePortalUser()
          && chatMember(chatId)
          && request.resource.data.senderId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.seen == false
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp', 'seen', 'attachment'])
          && (!request.resource.data.keys().hasAny(['attachment'])
            || (request.resource.data.attachment is map
              && request.resource.data.attachment.keys().hasOnly(['name', 'path', 'size', 'type', 'url'])
              && request.resource.data.attachment.get('name', '') is string
              && request.resource.data.attachment.get('path', '') is string
              && request.resource.data.attachment.get('size', 0) is number
              && request.resource.data.attachment.get('size', 0) < 10485760));
        allow update: if false;

        allow delete:
          if isFounder();
      }
    }


    // ============================================================
    // INSTITUTION WORKSPACES
    // Workspace metadata is readable by verified members.
    // Membership provisioning is restricted to trusted functions.
    // ============================================================

    match /institutions/{institutionId} {
      allow get: if institutionMember(institutionId)
        || staff()
        || (institutionApplicant(institutionId)
          && resource.data.get('ownerUid', '') == uid()
          && resource.data.get('status', '') == 'provisional');
      allow list: if staff();
      allow create, update, delete: if false;

      match /members/{memberId} {
        allow get: if signedIn()
          && (uid() == memberId || institutionManager(institutionId));
        allow list: if institutionManager(institutionId);
        allow create, update, delete: if false;
      }
    }

    // ============================================================
    // INSTITUTION APPLICATIONS
    // Applicants can submit and read only their own pending request.
    // Review and approval are reserved for trusted staff tooling.
    // ============================================================

    match /institutionApplications/{applicationId} {
      // Created atomically by the trusted callable with profile, workspace
      // and owner membership. Clients cannot create or modify applications.
      allow create: if false;
      allow get: if signedIn() && (uid() == applicationId || staff());
      allow list: if staff();
      allow update, delete: if false;
    }


    // ============================================================
    // INSTITUTION PAYMENT RECORDS
    // Payment records are server-written; only authorised staff
    // and the associated institution's active members may read.
    // ============================================================

    match /institutionPayments/{paymentId} {
      allow get, list: if staff()
        || (resource.data.get('institutionId', '') is string
          && institutionManager(resource.data.institutionId));
      allow create, update, delete: if false;
    }

    // ============================================================
    // UNIFIED MARKETPLACE CATALOGUE
    // Course listings are staff-managed and must match a published
    // course in the same atomic batch/transaction.
    // ============================================================
    function courseIsPublishedAfter(courseId) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      return existsAfter(coursePath)
        && (
          getAfter(coursePath).data.get('published', false) == true
          || getAfter(coursePath).data.get('status', '') == 'published'
        )
        && getAfter(coursePath).data.get('status', '') != 'deleted'
        && getAfter(coursePath).data.get('reviewStatus', '') == 'approved'
        && getAfter(coursePath).data.get('marketplaceVisibility', 'public') != 'hidden';
    }

    match /marketplaceItems/{itemId} {
      allow get, list: if resource.data.get('status', '') == 'published';

      allow create, update:
        if staff()
        && request.resource.data.get('productType', '') == 'course'
        && request.resource.data.get('sourceCollection', '') == 'courses'
        && request.resource.data.get('sourceId', '') is string
        && itemId == 'course_' + request.resource.data.sourceId
        && request.resource.data.get('status', '') == 'published'
        && request.resource.data.get('published', false) == true
        && courseIsPublishedAfter(request.resource.data.sourceId);

      allow delete:
        if staff()
        && resource.data.get('productType', '') == 'course'
        && resource.data.get('sourceCollection', '') == 'courses'
        && resource.data.get('sourceId', '') is string
        && itemId == 'course_' + resource.data.sourceId
        && !courseIsPublishedAfter(resource.data.sourceId);
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write:
        if false;
    }
  }
}