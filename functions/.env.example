# SSA payment backend environment
#
# Do not commit real secrets.
#
# In sandbox, MPESA_SHORTCODE and MPESA_PASSKEY may be omitted.
# functions/mpesa.js falls back to Safaricom's shared sandbox test credentials.
# For production, BOTH values must be supplied from the approved M-Pesa setup.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=spark_stack_academy

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=<Daraja consumer key>
MPESA_CONSUMER_SECRET=<Daraja consumer secret>
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=<sandbox test passkey, optional because the code has the shared sandbox fallback>
MPESA_CALLBACK_URL=https://<region>-<project-id>.cloudfunctions.net/mpesaPayments/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

PAYMENT_ALLOWED_ORIGINS=https://phinehas-hashi.github.io
