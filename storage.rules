rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isFounder() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/founder/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/founder/$(request.auth.uid)
        ).data.get('role', '') == 'founder'
        && firestore.get(
          /databases/(default)/documents/founder/$(request.auth.uid)
        ).data.get('status', '') == 'active'
        && firestore.get(
          /databases/(default)/documents/founder/$(request.auth.uid)
        ).data.get('active', true) == true
        && firestore.get(
          /databases/(default)/documents/founder/$(request.auth.uid)
        ).data.get('verified', true) == true;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/chats/$(chatId)
        )
        && (
          firestore.get(
            /databases/(default)/documents/chats/$(chatId)
          ).data.get('participants', []).hasAny([request.auth.uid])
          ||
          firestore.get(
            /databases/(default)/documents/chats/$(chatId)
          ).data.get('memberIds', []).hasAny([request.auth.uid])
        );
    }

    function isActiveInstructor(instructorId) {
      return signedIn()
        && request.auth.uid == instructorId
        && firestore.exists(/databases/(default)/documents/users/$(instructorId))
        && firestore.get(/databases/(default)/documents/users/$(instructorId)).data.get('role', '') == 'instructor'
        && firestore.get(/databases/(default)/documents/users/$(instructorId)).data.get('status', '') == 'active'
        && firestore.get(/databases/(default)/documents/users/$(instructorId)).data.get('active', false) == true
        && firestore.get(/databases/(default)/documents/users/$(instructorId)).data.get('verified', false) == true;
    }

    match /instructor-profile/{instructorId}/{fileName} {
      allow read: if true;
      allow create, update: if isActiveInstructor(instructorId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isActiveInstructor(instructorId);
    }

    match /academy-profile/{fileName} {
      allow read: if true;
      allow write: if isFounder()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /chatFiles/{chatId}/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow write: if isChatParticipant(chatId)
        && request.resource.size < 10 * 1024 * 1024;
    }

    function isActiveStudent(studentId) {
      return signedIn()
        && request.auth.uid == studentId
        && firestore.exists(/databases/(default)/documents/users/$(studentId))
        && firestore.get(/databases/(default)/documents/users/$(studentId)).data.get('role', '') == 'student'
        && firestore.get(/databases/(default)/documents/users/$(studentId)).data.get('status', '') == 'active'
        && firestore.get(/databases/(default)/documents/users/$(studentId)).data.get('active', true) == true;
    }

    function isPaymentReviewer() {
      return isFounder()
        || (
          signedIn()
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'administrator', 'moderator']
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('status', '') == 'active'
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('active', false) == true
        );
    }

    match /student-payment-proofs/{studentId}/{paymentId}/{fileName} {
      allow create: if isActiveStudent(studentId)
        && resource == null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && fileName.matches('.*\\.(jpg|jpeg|png|webp)');
      allow get: if isActiveStudent(studentId) || isPaymentReviewer();
      allow list, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
