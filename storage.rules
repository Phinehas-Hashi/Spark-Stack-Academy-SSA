rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isFounder() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/founder/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/founder/$(request.auth.uid)
        ).data.get('role', '') == 'founder'
        && firestore.get(
          /databases/(default)/documents/founder/$(request.auth.uid)
        ).data.get('status', '') == 'active'
        && firestore.get(
          /databases/(default)/documents/founder/$(request.auth.uid)
        ).data.get('active', false) == true
        && firestore.get(
          /databases/(default)/documents/founder/$(request.auth.uid)
        ).data.get('verified', false) == true;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/chats/$(chatId)
        )
        && (
          firestore.get(
            /databases/(default)/documents/chats/$(chatId)
          ).data.get('participants', []).hasAny([request.auth.uid])
          ||
          firestore.get(
            /databases/(default)/documents/chats/$(chatId)
          ).data.get('memberIds', []).hasAny([request.auth.uid])
        );
    }

    function hasActiveInstitutionMembership(institutionId) {
      let memberPath = /databases/(default)/documents/institutions/$(institutionId)/members/$(request.auth.uid);
      return signedIn()
        && firestore.exists(memberPath)
        && firestore.get(memberPath).data.get('uid', request.auth.uid) == request.auth.uid
        && firestore.get(memberPath).data.get('institutionId', institutionId) == institutionId
        && firestore.get(memberPath).data.get('status', '') == 'active'
        && firestore.get(memberPath).data.get('verified', false) == true;
    }

    function managesInstitution(institutionId) {
      let memberPath = /databases/(default)/documents/institutions/$(institutionId)/members/$(request.auth.uid);
      return hasActiveInstitutionMembership(institutionId)
        && firestore.get(memberPath).data.get('role', '') in [
          'institution_owner', 'owner', 'institution_admin', 'department_manager'
        ];
    }

    function isActiveInstructor(instructorId) {
      return signedIn()
        && request.auth.uid == instructorId
        && firestore.exists(/databases/(default)/documents/users/$(instructorId))
        && firestore.get(/databases/(default)/documents/users/$(instructorId)).data.get('role', '') == 'instructor'
        && firestore.get(/databases/(default)/documents/users/$(instructorId)).data.get('status', '') == 'active'
        && firestore.get(/databases/(default)/documents/users/$(instructorId)).data.get('active', false) == true
        && firestore.get(/databases/(default)/documents/users/$(instructorId)).data.get('verified', false) == true;
    }

    match /instructor-profile/{instructorId}/{fileName} {
      allow read: if true;
      allow create, update: if isActiveInstructor(instructorId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isActiveInstructor(instructorId);
    }

    match /academy-profile/{fileName} {
      allow read: if true;
      allow write: if isFounder()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /chatFiles/{chatId}/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow write: if isChatParticipant(chatId)
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Institution-owned files are tenant-scoped. Active members may read
    // shared files; only institution managers may publish or replace them.
    match /institution-files/{institutionId}/shared/{fileName} {
      allow read: if hasActiveInstitutionMembership(institutionId);
      allow create, update: if managesInstitution(institutionId)
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|application/pdf|video/.*)');
      allow delete: if managesInstitution(institutionId);
    }

    // Personal institutional member files are private to the member and
    // authorised institution managers.
    match /institution-files/{institutionId}/members/{memberUid}/{fileName} {
      allow read: if hasActiveInstitutionMembership(institutionId)
        && (request.auth.uid == memberUid || managesInstitution(institutionId));
      allow create, update: if hasActiveInstitutionMembership(institutionId)
        && request.auth.uid == memberUid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|application/pdf)');
      allow delete: if managesInstitution(institutionId)
        || (hasActiveInstitutionMembership(institutionId) && request.auth.uid == memberUid);
    }

    function isActiveStudent(studentId) {
      return signedIn()
        && request.auth.uid == studentId
        && firestore.exists(/databases/(default)/documents/users/$(studentId))
        && firestore.get(/databases/(default)/documents/users/$(studentId)).data.get('role', '') == 'student'
        && firestore.get(/databases/(default)/documents/users/$(studentId)).data.get('status', '') == 'active'
        && firestore.get(/databases/(default)/documents/users/$(studentId)).data.get('active', true) == true;
    }

    function isPaymentReviewer() {
      return isFounder()
        || (
          signedIn()
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'administrator', 'moderator']
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('status', '') == 'active'
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('active', false) == true
        );
    }

    match /student-payment-proofs/{studentId}/{paymentId}/{fileName} {
      allow create: if isActiveStudent(studentId)
        && resource == null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && fileName.matches('.*\\.(jpg|jpeg|png|webp)');
      allow get: if isActiveStudent(studentId) || isPaymentReviewer();
      allow list, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
